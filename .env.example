# Copy to .env and fill in. Real environment variables override this file.

# Live ingestion: must be a direct audio endpoint (Icecast .mp3 / .aac or HLS .m3u8), not a web page.
LIVE_STREAM_URL=
LIVE_SOURCE_NAME=AIR Live
LIVE_CHUNK_SECONDS=30
LIVE_OVERLAP_SECONDS=5
# 0 = reconnect forever (overnight runs)
LIVE_MAX_RETRIES=0
# 1 = start live ingestion when the API server starts
LIVE_AUTOSTART=0

# Speech recognition (faster-whisper). Use cuda + float16 with an NVIDIA GPU.
VANI_ASR_MODEL=small
VANI_ASR_DEVICE=cpu
VANI_ASR_COMPUTE_TYPE=int8
VANI_ASR_LANGUAGE=en

# Answer generation (optional; without a key answers are extractive quotes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the primary model hits its quota (429) or is retired (404)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite

# "today" = relative dates use the real IST date (live); "corpus" = newest corpus date (archive demos)
VANI_DATE_ANCHOR=today
VANI_TIMEZONE=Asia/Kolkata
